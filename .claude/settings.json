{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "timeout": 10,
            "command": "G=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-guard.py\"; [ -f \"$G\" ] || exit 0; PY=$(command -v python3 || command -v python) || exit 0; \"$PY\" \"$G\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh secret list:*)",
      "Bash(gh workflow list:*)",
      "Bash(az account:*)",
      "Bash(az group:*)",
      "Bash(az resource:*)",
      "Bash(az containerapp show:*)",
      "Bash(az containerapp list:*)",
      "Bash(az containerapp logs:*)",
      "Bash(az containerapp revision list:*)",
      "Bash(az containerapp revision show:*)",
      "Bash(az containerapp env show:*)",
      "Bash(az containerapp env list:*)",
      "Bash(az acr show:*)",
      "Bash(az acr list:*)",
      "Bash(az acr repository list:*)",
      "Bash(az acr repository show:*)",
      "Bash(az acr repository show-tags:*)",
      "Bash(az acr check-name:*)",
      "Bash(az monitor:*)",
      "Bash(az storage blob list:*)",
      "Bash(az storage blob show:*)",
      "Bash(az storage container list:*)",
      "Bash(az storage container show:*)",
      "Bash(az storage account show:*)",
      "Bash(az storage account list:*)",
      "Bash(az storage account check-name:*)",
      "Bash(az sql db show:*)",
      "Bash(az sql db list:*)",
      "Bash(az sql db list-editions:*)",
      "Bash(az sql server show:*)",
      "Bash(az sql server list:*)",
      "Bash(az sql list-usages:*)",
      "Bash(az role assignment list:*)",
      "Bash(az role definition list:*)",
      "Bash(az extension show:*)",
      "Bash(az extension list:*)",
      "Bash(az provider show:*)",
      "Bash(az provider list:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf .git:*)",
      "Bash(sudo rm:*)",
      "Bash(az account clear:*)",
      "Bash(az logout:*)",
      "Bash(az group create:*)",
      "Bash(az group delete:*)",
      "Bash(az group update:*)",
      "Bash(az resource create:*)",
      "Bash(az resource delete:*)",
      "Bash(az resource update:*)",
      "Bash(az resource move:*)",
      "Bash(az resource tag:*)",
      "Bash(az resource invoke-action:*)",
      "Bash(az containerapp create:*)",
      "Bash(az containerapp update:*)",
      "Bash(az containerapp delete:*)",
      "Bash(az containerapp up:*)",
      "Bash(az containerapp exec:*)",
      "Bash(az containerapp revision activate:*)",
      "Bash(az containerapp revision copy:*)",
      "Bash(az containerapp revision set-mode:*)",
      "Bash(az containerapp revision label:*)",
      "Bash(az containerapp ingress:*)",
      "Bash(az containerapp secret:*)",
      "Bash(az containerapp identity:*)",
      "Bash(az containerapp hostname:*)",
      "Bash(az containerapp auth:*)",
      "Bash(az containerapp registry set:*)",
      "Bash(az containerapp registry remove:*)",
      "Bash(az containerapp env create:*)",
      "Bash(az containerapp env delete:*)",
      "Bash(az containerapp env update:*)",
      "Bash(az acr create:*)",
      "Bash(az acr delete:*)",
      "Bash(az acr update:*)",
      "Bash(az acr import:*)",
      "Bash(az acr build:*)",
      "Bash(az acr run:*)",
      "Bash(az acr purge:*)",
      "Bash(az acr task:*)",
      "Bash(az acr credential:*)",
      "Bash(az acr login:*)",
      "Bash(az acr repository delete:*)",
      "Bash(az acr repository untag:*)",
      "Bash(az storage account create:*)",
      "Bash(az storage account update:*)",
      "Bash(az storage account delete:*)",
      "Bash(az storage container create:*)",
      "Bash(az storage container delete:*)",
      "Bash(az storage blob upload:*)",
      "Bash(az storage blob delete:*)",
      "Bash(az sql server create:*)",
      "Bash(az sql server update:*)",
      "Bash(az sql server delete:*)",
      "Bash(az sql server ad-admin:*)",
      "Bash(az sql server ad-only-auth:*)",
      "Bash(az sql server firewall-rule create:*)",
      "Bash(az sql server firewall-rule update:*)",
      "Bash(az sql server firewall-rule delete:*)",
      "Bash(az sql db create:*)",
      "Bash(az sql db update:*)",
      "Bash(az sql db delete:*)",
      "Bash(az monitor log-analytics workspace create:*)",
      "Bash(az monitor log-analytics workspace update:*)",
      "Bash(az monitor log-analytics workspace delete:*)",
      "Bash(az monitor diagnostic-settings create:*)",
      "Bash(az monitor diagnostic-settings delete:*)",
      "Bash(az role assignment create:*)",
      "Bash(az role assignment delete:*)",
      "Bash(az role definition create:*)",
      "Bash(az role definition delete:*)",
      "Bash(az ad sp create-for-rbac:*)",
      "Bash(az ad app create:*)",
      "Bash(az ad app credential reset:*)",
      "Bash(az rest --method put:*)",
      "Bash(az rest --method patch:*)",
      "Bash(az rest --method post:*)",
      "Bash(az rest --method delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh variable set:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
